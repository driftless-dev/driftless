# Copy to .env for local notes. Driftless does not load this file automatically;
# export variables in your shell, or set them as GitHub Actions secrets.

# --- Repair / judge (at least one required for --generator llm) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional catalog refresh (tools/refresh_catalog.py) ---
GEMINI_API_KEY=

# --- Optional harness auth ---
# Bearer token for run.endpoint workflows.
DRIFTLESS_ENDPOINT_TOKEN=
# Token for eval.data_source fetches.
DRIFTLESS_DATASOURCE_TOKEN=

# --- GitHub delivery (open-pr --create, plan --act --create) ---
# Locally this is usually provided by `gh auth`. In Actions, github.token is enough
# when the workflow has contents/pull-requests permissions.
GH_TOKEN=

# --- Test / CI knobs ---
# DRIFTLESS_LIVE_EVAL=1
# DRIFTLESS_PROGRESS=1
# DRIFTLESS_REGRESSION_METRICS=.driftless/regression-metrics.jsonl
